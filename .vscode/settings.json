{
  // ~ FILE-PATH: .vscode/settings.json
  //
  //@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  //@
  //@                   ⚙️  GENERAL EDITOR SETTINGS
  //@
  //@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  //
  // // #region* 📁 GENERAL
  //
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.trimTrailingWhitespace": false,
  "files.trimTrailingWhitespaceInRegexAndStrings": false,
  "files.associations": {
    "*.css": "tailwindcss",
    "*.json": "jsonc",
    "*.editorconfig": "editorconfig",
    "*.psm1": "powershell",
    "*.psd1": "powershell",
    "*.ps1": "powershell"
  },
  // #endregion
  //
  // // #region* 📁 WORKBENCH & APPEARANCE
  //
  "workbench.colorTheme": "Theme Darker",
  "workbench.iconTheme": "flow-deep",
  "workbench.productIconTheme": "material-product-icons",
  "workbench.panel.defaultLocation": "right",
  // #endregion
  //
  // // #region* 📁 EDITOR CORE
  //
  "editor.fontFamily": "'Iosevka NFM'",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.4,
  "editor.fontLigatures": true,
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.preview": true,
  "editor.tabCompletion": "on",
  "editor.showDeprecated": true,
  "editor.autoIndent": "full",
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 80,
  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "enabled": true
  },
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.defaultModel": "indentationModel",
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.guides.highlightActiveBracketPair": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.codeActions.triggerOnFocusChange": true,
  "editor.codeActionsOnSave": {
    "source.format.oxc": "always",
    "source.fixAll": "always",
    "source.fixAll.oxc": "always",
    "source.organizeImports": "explicit",
    "source.addMissingImports": "explicit"
  },
  "editor.trimAutoWhitespace": false,
  "editor.defaultFoldingRangeProvider": "maptz.regionfolder",
  "editor.foldingStrategy": "indentation",
  "editor.folding": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnType": false,
  "editor.formatOnPaste": true,
  "editor.glyphMargin": true,
  "editor.quickSuggestions": {
    "strings": true
  },
  "files.autoSave": "onFocusChange",
  // #endregion
  //
  // // #region* 📁 TERMINAL
  //
  "terminal.integrated.fontFamily": "'Iosevka NFM'",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.profiles.linux": {
    "fish-host": {
      "path": "host-spawn",
      "args": ["fish"],
      "icon": "terminal-linux"
    }
  },
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.minimumContrastRatio": 1,
  // #endregion
  //
  //@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  //@
  //@                   🛠️  LANGUAGE SPECIFIC SETTINGS
  //@
  //@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  //
  // // #region* 📁 HTML/CSS/TAILWINDCSS
  //
  "css.styleSheets": ["node_modules/bulma/css/bulma.min.css", "src/**/*.css"],
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "html.format.wrapAttributes": "force-expand-multiline",
  // #endregion
  //
  // // #region* 📁 JAVASCRIPT/TYPESCRIPT
  //
  "extensions.experimental.affinity": {
    "better-ts-errors.better-ts-errors": 1
  },
  "editor.experimental.preferTreeSitter.typescript": true,
  // Language Formatters
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  //
  //* Legacy Engine Settings (For Work)
  //
  // "javascript.inlayHints.parameterNames.enabled": "all",
  // "javascript.inlayHints.variableTypes.enabled": true,
  // "javascript.inlayHints.parameterTypes.enabled": true,
  // "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
  // "javascript.format.semicolons": "insert",
  // "javascript.preferences.quoteStyle": "single",
  // "javascript.referencesCodeLens.enabled": true,
  // "javascript.suggest.autoImports": true,
  // "javascript.updateImportsOnPaste.enabled": true,
  // "javascript.updateImportsOnFileMove.enabled": "always",
  // "javascript.suggest.paths": false,
  // "javascript.suggestionActions.enabled": true,
  // "typescript.inlayHints.parameterNames.enabled": "all",
  // "typescript.inlayHints.variableTypes.enabled": true,
  // "typescript.inlayHints.parameterTypes.enabled": true,
  // "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  // "typescript.format.semicolons": "insert",
  // "typescript.preferences.quoteStyle": "single",
  // "typescript.referencesCodeLens.enabled": true,
  // "typescript.suggest.autoImports": true,
  // "typescript.updateImportsOnPaste.enabled": true,
  // "typescript.updateImportsOnFileMove.enabled": "always",
  // "typescript.suggest.paths": false,
  // "typescript.suggestionActions.enabled": true,
  // "typescript.tsserver.log": "off",
  // "typescript.tsserver.useSyntaxServer": "never",
  // // Performance Tweak: Safe across versions to stop file-switch delays
  // "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  // //"typescript.tsserver.experimental.enableProjectDiagnostics": false,
  // //"typescript.tsdk": "node_modules/typescript",
  // "typescript.enablePromptUseWorkspaceTsdk": true,
  // "typescript.experimental.useTsgo": true,
  //
  //* Modern Engine Settings (For Home)
  //
  // 📁 LANGUAGE SERVER & COMPILER (TS 7.0 / TSGO)
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.experimental.useTsgo": true,
  //
  // ⚡ PERFORMANCE & DIAGNOSTICS
  "js/ts.tsserver.log": "off",
  "js/ts.tsserver.useSyntaxServer": "never",
  //
  // Performance Tweak: Safe across versions to stop file-switch delays
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  //
  // 📦 IMPORTS & AUTO-SUGGESTIONS
  "js/ts.suggest.autoImports": true,
  "js/ts.suggest.paths": false,
  "js/ts.suggestionActions.enabled": true,
  "js/ts.updateImportsOnPaste.enabled": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  //
  // 📝 FORMATTING & PREFERENCES
  "js/ts.format.semicolons": "insert",
  "js/ts.preferences.quoteStyle": "single",
  //
  // 💡 INLAY HINTS (INLINE TYPE VISUALS)
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.inlayHints.variableTypes.enabled": true,
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  //
  // 🔍 CODE LENS (REFERENCES COUNTER)
  "js/ts.referencesCodeLens.enabled": true,
  // #endregion
  //
  // // #region* 📁 MARKDOWN
  //
  "markdown.validate.enabled": true,
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  // #endregion
  //
  // // #region* 📁 JSON/JSONC
  //
  "json.schemaDownload.enable": false,
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  // #endregion
  //
  // // #region* 📁 BUN
  //
  // HOME SETTINGS:
  // The path to the `bun` executable.
  "bun.runtime": "${env:HOME}/.bun/bin/bun",
  // If support for Bun should be added to the default "JavaScript Debug Terminal".
  "bun.debugTerminal.enabled": true,
  // If the debugger should stop on the first line of the program.
  "bun.debugTerminal.stopOnEntry": false,
  // Glob pattern to find test files. Defaults to the value shown below.
  "bun.test.filePattern": "**/*{.test.,.spec.,_test_,_spec_}{js,ts,tsx,jsx,mts,cts,cjs,mjs}",
  // The custom script to call for testing instead of `bun test`
  "bun.test.customScript": "bun test",
  //
  // WORK SETTINGS
  //"bun.runtime": "C:\\Users\\dustin.r.dew.civ\\.bun\\bin\\bun.exe",
  //"bun.debugTerminal.enabled": true,
  //"bun.debugTerminal.stopOnEntry": false,
  //"bun.test.filePattern": "**/*{.test.,.spec.,_test_,_spec_}{js,ts,tsx,jsx,mts,cts,cjs,mjs}",
  //"bun.test.customScript": "bun test",
  // #endregion
  //
  // // #region* 📁 GIT
  //
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  // #endregion
  //
  // // #region* 📁 POWERSHELL
  //
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  // #endregion
  //
  //@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  //@
  //@                   🧩  EXTENSION-SPECIFIC SETTINGS
  //@
  //@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
  //
  // // #region* 📁 TOML AND EDITORCONFIG
  //
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  "evenBetterToml.formatter.alignEntries": true,
  "evenBetterToml.formatter.alignComments": true,
  "evenBetterToml.formatter.allowedBlankLines": 2,
  "[editorconfig]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  // #endregion
  //
  // // #region* 📁 LINTING/FORMATTING
  //
  "oxc.enable": true,
  "oxc.lint.run": "onType",
  "oxc.requireConfig": true,
  // #endregion
  //
  // // #region* 📁 REGION FOLDING
  //
  "maptz.regionfolder": {
    "[json]": {
      "foldEnd": "// #endregion",
      "foldStart": "// #region [NAME]",
      "foldDefinitions": [
        {
          // Matches: // // #region* My Section Name
          "foldStartRegex": "//[\\s]*// #region*[\\s]*(.*)",
          "foldEndRegex": "//[\\s]*#endregion",
          "isFoldedByDefault": true
        },
        {
          // Matches: // 📁 My Section Name
          "foldStartRegex": "//[\\s]*#region[\\s]*(.*)",
          "foldEndRegex": "//[\\s]*#endregion",
          "isFoldedByDefault": false
        }
      ]
    },
    "[jsonc]": {
      "foldEnd": "// #endregion",
      "foldStart": "// #region [NAME]",
      "foldDefinitions": [
        {
          "foldStartRegex": "//[\\s]*// #region*[\\s]*(.*)",
          "foldEndRegex": "//[\\s]*#endregion",
          "isFoldedByDefault": true
        },
        {
          "foldStartRegex": "//[\\s]*#region[\\s]*(.*)",
          "foldEndRegex": "//[\\s]*#endregion",
          "isFoldedByDefault": false
        }
      ]
    }
  },
  // #endregion
  //
  // // #region* 📁 BETTER COMMENTS
  //
  "better-comments.multilineComments": true,
  "better-comments.highlightPlainText": false,
  "better-comments.tags": [
    {
      "tag": "!",
      "color": "#FF6E6E",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": true,
      "italic": false
    },
    {
      "tag": "?",
      "color": "#8be9fd",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "//",
      "color": "#50fa7b",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "///",
      "color": "#50fa7b",
      "strikethrough": true,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "$",
      "color": "#50fa7b",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "@",
      "color": "#ffb86c",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "fixme",
      "color": "#6272a4",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "fixit",
      "color": "#6272a4",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "fix",
      "color": "#6272a4",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "#",
      "color": "#ff5555",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "*",
      "color": "#ff79c6",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": true,
      "italic": false
    },
    {
      "tag": "&",
      "color": "#D6ACFF",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": true,
      "italic": true
    },
    {
      "tag": "📁",
      "color": "#BD93F9",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "🛑",
      "color": "#FF6E6E",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    }
  ],
  // #endregion
  //
  // // #region* 📁 INDENT RAINBOW
  //
  "indentRainbow.excludedLanguages": ["plaintext", "log", "logfile"],
  "indentRainbow.indicatorStyle": "classic",
  "indentRainbow.lightIndicatorStyleLineWidth": 1,
  "indentRainbow.colorOnWhiteSpaceOnly": true,
  "indentRainbow.updateDelay": 100,
  "indentRainbow.errorColor": "rgba(128,32,32,0.6)",
  "indentRainbow.tabmixColor": "rgba(128,32,96,0.6)",
  "indentRainbow.colors": [
    "rgba(255,255,64,0.07)",
    "rgba(127,255,127,0.07)",
    "rgba(255,127,255,0.07)",
    "rgba(79,236,236,0.07)"
  ],
  // #endregion
  //
  // // #region* 📁 COLORIZE
  //
  "colorize.decoration_type": "background",
  "colorize.enable_search_variables": true,
  "colorize.hide_current_line_decorations": true,
  "colorize.colorized_colors": ["HEXA", "ARGB", "RGB", "HSL", "OKLAB", "OKLCH"],
  "colorize.languages": [
    "css",
    "scss",
    "sass",
    "less",
    "html",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "json",
    "jsonc",
    "toml",
    "python",
    "java",
    "powershell",
    "ps1",
    "psd1",
    "markdown",
    "md",
    "mdx"
  ],
  "colorize.include": [
    "**/src/**",
    "**/*.html",
    "**/*.css",
    "**/*.toml",
    "**/*.json",
    "**/*.jsonc"
  ],
  "colorize.exclude": ["**/node_modules/**", "**/ALL/**"],
  "colorize.colorized_variables": ["LESS"],
  // #endregion
  //
  // // #region* 📁 HIGHLIGHT
  //
  //
  // Dracula Classic:
  // Token        Hex        Usage
  //
  // Background    #282A36    Main background
  // Current Line  #6272A4    Semantic current line highlight token
  // Selection    #44475A    Text selection
  // Foreground    #F8F8F2    Default text
  // Comment      #6272A4    Comments, disabled code
  // Red          #FF5555    Errors, warnings, deletion
  // Orange        #FFB86C    Numbers, constants, booleans
  // Yellow        #F1FA8C    Strings, text content
  // Green        #50FA7B    Functions, methods, inherited classes
  // Cyan          #8BE9FD    Classes, types, support, regex
  // Purple        #BD93F9    Instance reserved words, constants
  // Pink          #FF79C6    Keywords, storage types
  //
  //
  "highlight.decorations": {},
  "highlight.regexFlags": "g",
  "highlight.regexes": {
    //
    //$ Highlight file paths in `//` comments with a specific format, e.g.:
    "/(^|[ \\t]?(\/\/)\\s?(~?)\\s?(file-path)\\s{0}(:)\\s{1}(.*)[\\t]?)$/gim": {
      "filterLanguageRegex": "(javascript|typescript|js|ts|jsx|tsx|json|jsonc|toml|yaml|yml|fish|ps1)",
      "filterFilepaths": true,
      "decorations": [
        {
          // Group 1
          "overviewRulerColor": "#FFB86C",
          "backgroundColor": "#44475A",
          "borderRadius": "4px",
          "border": "1px dotted #FFB86C",
          "rangeBehavior": 1
        },
        {
          // Group 2
          "color": "#FFB86C"
        },
        {
          // Group 3
          "color": "#FFB86C"
        },
        {
          // Group 4
          "color": "#FF79C6"
        },
        {
          // Group 5
          "color": "#FFB86C"
        },
        {
          // Group 6
          "color": "#BD93F9",
          "textDecoration": "none; padding: 0 8px 0 0;",
          "after": {
            "contentText": ""
          }
        }
      ]
    },
    //
    //$ Highlight file paths in `#` comments with a specific format, e.g.:
    "/(^|[ \\t]?(#)\\s?(~?)\\s?(file-path)\\s{0}(:)\\s{1}(.*)[\\t]?)$/gim": {
      "filterLanguageRegex": "(javascript|typescript|js|ts|jsx|tsx|json|jsonc|toml|yaml|yml|fish|ps1)",
      "filterFilepaths": true,
      "decorations": [
        {
          // Group 1
          "overviewRulerColor": "#FFB86C",
          "backgroundColor": "#44475A",
          "borderRadius": "4px",
          "border": "1px dotted #FFB86C",
          "rangeBehavior": 1
        },
        {
          // Group 2
          "color": "#FFB86C"
        },
        {
          // Group 3
          "color": "#FFB86C"
        },
        {
          // Group 4
          "color": "#FF79C6"
        },
        {
          // Group 5
          "color": "#FFB86C"
        },
        {
          // Group 6
          "color": "#BD93F9",
          "textDecoration": "none; padding: 0 8px 0 0;",
          "after": {
            "contentText": ""
          }
        }
      ]
    },
    //
    //$ Highlight web URLs in comments with a specific format, e.g.:
    "/(\\s?([a-zA-Z0-9+.-]+:\\/\\/[a-zA-Z0-9@:%._\\+~#=\\-]{1,256}(?::\\d+)?(?:[-a-zA-Z0-9()@:%_\\+.~#?&\\/=]*))\\h?)/gim": {
      "filterLanguageRegex": "(javascript|typescript|js|ts|jsx|tsx|json|jsonc|toml|yaml|yml)",
      "decorations": [
        {
          "backgroundColor": "#44475A",
          "borderRadius": "4px",
          "border": "0.5px dashed #FFB86C",
          "padding": "0 0 0 8px",
          "before": {
            "contentText": ""
          }
        },
        {
          "color": "#FFB86C",
          "backgroundColor": "transparent",
          "fontWeight": "normal",
          "textDecoration": "none; padding: 0 8px 0 0;",
          "after": {
            "contentText": ""
          }
        }
      ]
    }
  },
  // #endregion
  //
  // // #region* 📁 SPLIT HTML ATTRIBUTES
  //
  "splitHTMLAttributes.tabSize": 2,
  "splitHTMLAttributes.useSpacesForTabs": true,
  "splitHTMLAttributes.closingBracketOnNewLine": true,
  "splitHTMLAttributes.sortOrder": [
    "^xmlns",
    "^role",
    "^viewBox",
    "^key",
    "^:",
    "^id$",
    "^class$",
    "^x1?$",
    "^y1?$",
    "^x2$",
    "^y2$",
    "^cx$",
    "^cy$",
    "^r$",
    "^width$",
    "^height$",
    "^fill",
    "^stroke",
    "^style",
    "^d$",
    "^points$",
    "^.*=\""
  ],
  // #endregion
  //
  // // #region* 📁 HIDE PROJECT CONFIGURATION FILES FROM VIEW
  //
  "files.exclude": {
    "**/node_modules/**": true,
    "**/.editorconfig": true,
    //"**/.gitignore": true,
    "**/.ox*.json": true,
    "**/tsconfig*": true,
    "**/*.lock": true,
    "**/*.md": true,
    "**/bunfig.toml": true
  }
  // #endregion
}
