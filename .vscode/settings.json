{
  // ~ FILE-PATH: .vscode/settings.json
  // ==========================================================================
  //      ⚙️ GENERAL SETTINGS
  // ==========================================================================
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.trimTrailingWhitespaceInRegexAndStrings": false,
  "files.associations": {
    "*.css": "tailwindcss",
    "*.json": "jsonc",
    "*.editorconfig": "editorconfig",
    "*.psm1": "powershell",
    "*.psd1": "powershell",
    "*.ps1": "powershell"
  },
  // ==========================================================================
  //      🎨 WORKBENCH & APPEARANCE
  // ==========================================================================
  "workbench.colorTheme": "Theme Darker",
  "workbench.iconTheme": "flow-deep",
  "workbench.productIconTheme": "material-product-icons",
  "workbench.panel.defaultLocation": "right",
  // ==========================================================================
  //      📝 EDITOR CORE SETTINGS
  // ==========================================================================
  "editor.fontFamily": "'JetBrainsMono NFM Regular'",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.4,
  "editor.fontLigatures": true,
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.preview": true,
  "editor.tabCompletion": "on",
  "editor.showDeprecated": true,
  "editor.autoIndent": "full",
  "editor.wordWrapColumn": 100,
  "editor.rulers": [
    100
  ],
  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "enabled": true
  },
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.defaultModel": "indentationModel",
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.guides.highlightActiveBracketPair": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.codeActions.triggerOnFocusChange": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.addMissingImports": "explicit"
  },
  "editor.wordWrap": "on",
  "editor.defaultFoldingRangeProvider": "EditorConfig.EditorConfig",
  "editor.foldingStrategy": "auto",
  "editor.folding": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": false,
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "editor.formatOnType": false,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.glyphMargin": true,
  "editor.quickSuggestions": {
    "strings": true
  },
  "files.autoSave": "onFocusChange",
  // ==========================================================================
  //      🖥️ TERMINAL SETTINGS
  // ==========================================================================
  "terminal.integrated.fontFamily": "'JetBrainsMono NFM Regular'",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.lineHeight": 1,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.profiles.linux": {
    "fish-host": {
      "path": "host-spawn",
      "args": [
        "fish"
      ],
      "icon": "terminal-linux"
    }
  },
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.minimumContrastRatio": 1,
  //***************************************************************************
  //*
  //*      💻 LANGUAGE SPECIFIC SETTINGS
  //*
  //***************************************************************************
  // ==========================================================================
  //      ⚙️ HTML/CSS SETTINGS
  // ==========================================================================
  "css.styleSheets": [
    "node_modules/bulma/css/bulma.min.css",
    "src/**/*.css"
  ],
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "html.format.wrapAttributes": "force-expand-multiline",
  // ==========================================================================
  //      ⚙️ JAVASCRIPT/TYPESCRIPT SETTINGS (DUAL COMPATIBLE)
  // ==========================================================================
  "extensions.experimental.affinity": {
    "better-ts-errors.better-ts-errors": 1
  },
  "editor.experimental.preferTreeSitter.typescript": true,
  // Language Formatters
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  // Legacy Engine Settings (For Work)
  "javascript.inlayHints.parameterNames.enabled": "all",
  "javascript.inlayHints.variableTypes.enabled": true,
  "javascript.inlayHints.parameterTypes.enabled": true,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
  "javascript.format.semicolons": "insert",
  "javascript.preferences.quoteStyle": "single",
  "javascript.referencesCodeLens.enabled": true,
  "javascript.suggest.autoImports": true,
  "javascript.updateImportsOnPaste.enabled": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.suggest.paths": false,
  "javascript.suggestionActions.enabled": true,
  "typescript.inlayHints.parameterNames.enabled": "all",
  "typescript.inlayHints.variableTypes.enabled": true,
  "typescript.inlayHints.parameterTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
  "typescript.format.semicolons": "insert",
  "typescript.preferences.quoteStyle": "single",
  "typescript.referencesCodeLens.enabled": true,
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnPaste.enabled": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.suggest.paths": false,
  "typescript.suggestionActions.enabled": true,
  "typescript.tsserver.log": "off",
  "typescript.tsserver.useSyntaxServer": "always",
  // Performance Tweak: Safe across versions to stop file-switch delays
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  // Modern Engine Settings (For Home)
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.inlayHints.variableTypes.enabled": true,
  "js/ts.inlayHints.parameterTypes.enabled": true,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.format.semicolons": "insert",
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.suggest.autoImports": true,
  "js/ts.updateImportsOnPaste.enabled": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.suggest.paths": false,
  "js/ts.suggestionActions.enabled": true,
  "js/ts.tsserver.log": "off",
  "js/ts.tsserver.useSyntaxServer": "always",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  // ==========================================================================
  //      ⚙️ MARKDOWN SETTINGS
  // ==========================================================================
  "markdown.validate.enabled": true,
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "markdownlint.config": {
    "default": true,
    "MD033": {
      "allowed_elements": [
        "span"
      ]
    },
    "MD041": false,
    "MD026": false
  },
  // ==========================================================================
  //      ⚙️ JSON/JSONC SETTINGS
  // ==========================================================================
  "json.schemaDownload.enable": false,
  "[json]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  // ==========================================================================
  //      ⚙️ BUN SETTINGS
  // ==========================================================================
  "bun.runtime": "%USERPROFILE%/.bun/bin/bun",
  "bun.debugTerminal.enabled": true,
  "bun.debugTerminal.stopOnEntry": false,
  "bun.test.filePattern": "**/*{.test.,.spec.,_test_,_spec_}{js,ts,tsx,jsx,mts,cts,cjs,mjs}",
  "bun.test.customScript": "bun test",
  // ==========================================================================
  //      ⚙️ GIT SETTINGS
  // ==========================================================================
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  // ==========================================================================
  //      ⚙️ POWERSHELL SETTINGS
  // ==========================================================================
  "[powershell]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  //***************************************************************************
  //*
  //*         ➕ EXTENSION-SPECIFIC SETTINGS
  //*
  //***************************************************************************
  // ==========================================================================
  //      ⚙️ TOML AND EDITORCONFIG SETTINGS
  // ==========================================================================
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  "evenBetterToml.formatter.alignEntries": true,
  "evenBetterToml.formatter.alignComments": true,
  "evenBetterToml.formatter.allowedBlankLines": 2,
  "[editorconfig]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  // ==========================================================================
  //      ⚙️ PRETTIER/ESLINT SETTINGS
  // ==========================================================================
  "prettier.useEditorConfig": true,
  "eslint.useFlatConfig": true,
  "eslint.format.enable": true,
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "types"
  ],
  "eslint.codeAction.showDocumentation": {
    "enable": true
  },
  "eslint.codeAction.disableRuleComment": {
    "enable": true,
    "location": "sameLine"
  },
  "eslint.options": {
    "overrideConfigFile": "eslint.config.ts"
  },
  // ==========================================================================
  //      ⚙️ REGION FOLDING SETTINGS
  // ==========================================================================
  "maptz.regionfolder": {
    "[json]": {
      "foldEnd": "/* #endregion */",
      "foldEndRegex": "/\\*[\\s]*#endregion",
      "foldStart": "/* #region [NAME] */",
      "foldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*(.*)[\\s]*\\*/[\\s]*$",
      "defaultFoldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*default\\s(.*)[\\s]*\\*/[\\s]*$",
      "foldDefinitions": [
        {
          "foldEndRegex": "\\*+/[\\s]*$",
          "foldStartRegex": "^[\\s]*/\\*\\*+",
          "isFoldedByDefault": true
        }
      ]
    },
    "[jsonc]": {
      "foldEnd": "/* #endregion */",
      "foldEndRegex": "/\\*[\\s]*#endregion",
      "foldStart": "/* #region [NAME] */",
      "foldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*(.*)[\\s]*\\*/[\\s]*$",
      "defaultFoldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*default\\s(.*)[\\s]*\\*/[\\s]*$",
      "foldDefinitions": [
        {
          "foldEndRegex": "\\*+/[\\s]*$",
          "foldStartRegex": "^[\\s]*/\\*\\*+",
          "isFoldedByDefault": true
        }
      ]
    },
    "[javascript]": {
      "foldEnd": "/* #endregion */",
      "foldEndRegex": "/\\*[\\s]*#endregion",
      "foldStart": "/* #region [NAME] */",
      "foldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*(.*)[\\s]*\\*/[\\s]*$",
      "defaultFoldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*default\\s(.*)[\\s]*\\*/[\\s]*$",
      "foldDefinitions": [
        {
          "foldEndRegex": "\\*+/[\\s]*$",
          "foldStartRegex": "^[\\s]*/\\*\\*+",
          "isFoldedByDefault": true
        }
      ]
    },
    "[javascriptreact]": {
      "foldEnd": "/* #endregion */",
      "foldEndRegex": "/\\*[\\s]*#endregion",
      "foldStart": "/* #region [NAME] */",
      "foldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*(.*)[\\s]*\\*/[\\s]*$",
      "defaultFoldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*default\\s(.*)[\\s]*\\*/[\\s]*$",
      "foldDefinitions": [
        {
          "foldEndRegex": "\\*+/[\\s]*$",
          "foldStartRegex": "^[\\s]*/\\*\\*+",
          "isFoldedByDefault": true
        }
      ]
    },
    "[typescript]": {
      "foldEnd": "/* #endregion */",
      "foldEndRegex": "/\\*[\\s]*#endregion",
      "foldStart": "/* #region [NAME] */",
      "foldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*(.*)[\\s]*\\*/[\\s]*$",
      "defaultFoldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*default\\s(.*)[\\s]*\\*/[\\s]*$",
      "foldDefinitions": [
        {
          "foldEndRegex": "\\*+/[\\s]*$",
          "foldStartRegex": "^[\\s]*/\\*\\*+",
          "isFoldedByDefault": true
        }
      ]
    },
    "[typescriptreact]": {
      "foldEnd": "/* #endregion */",
      "foldEndRegex": "/\\*[\\s]*#endregion",
      "foldStart": "/* #region [NAME] */",
      "foldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*(.*)[\\s]*\\*/[\\s]*$",
      "defaultFoldStartRegex": "^[\\s]*/\\*[\\s]*#region[\\s]*default\\s(.*)[\\s]*\\*/[\\s]*$",
      "foldDefinitions": [
        {
          "foldEndRegex": "\\*+/[\\s]*$",
          "foldStartRegex": "^[\\s]*/\\*\\*+",
          "isFoldedByDefault": true
        }
      ]
    }
  },
  // ==========================================================================
  //      ⚙️ BETTER COMMENTS SETTINGS
  // ==========================================================================
  "better-comments.multilineComments": true,
  "better-comments.highlightPlainText": false,
  "better-comments.tags": [
    {
      "tag": "!",
      "color": "#FF6E6E",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
