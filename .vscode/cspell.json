{
  // FILE-PATH: .vscode/cspell.json
  //
  "enabled": true,
  "version": "0.2",
  "language": "en, en-GB",
  "words": [
    // List of words to be considered correct
  ],
  "flagWords": [
    // List of words to be always considered incorrect
    // Extracted into .vscode/cspell-flagwords.json via the import block below
  ],
  "ignoreWords": [
    // Add any specific words you want to ignore here
  ],
  "ignorePaths": [
    "**/ALL/**",
    "**/ALL_REBUILT/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**"
  ],
  "maxNumberOfProblems": 10000,
  "minWordLength": 4,
  "allowCompoundWords": true,
  "dictionaries": [
    // Local custom dictionaries
    // Extracted into .vscode/cspell-dictionary.json via the import block below
  ],
  "dictionaryDefinitions": [
    // Local custom dictionary definition files
    // Extracted into .vscode/cspell-dictionary.json via the import block below
  ],
  "ignoreRegExpList": [
    // List of patterns to be ignored
  ],
  "includeRegExpList": [
    // (Advanced) limits the text checked to be only that matching the expressions in the list
  ],
  "patterns": [
    // Define named patterns to be used with ignoreRegExpList and includeRegExpList
  ],
  "languageSettings": [
    // Allow configuration to be based upon the programming language and/or the language locale
    // https://cspell.org/docs/Configuration/language-settings
  ],
  "overrides": [
    // Apply settings for specific files in your project
    //
    // Force `*.lock` and `*.lockb` files to be treated as `cpp` files:
    {
      "filename": "**/{*.lock,*.lockb}",
      "languageId": "json"
    },
    {
      "filename": "**/images/**",
      "enabled": false // Disable spellchecking.
    }
  ],
  "import": [
    // Import other cspell configuration files if necessary
    "./cspell-flagwords.json",
    "./cspell-dictionary.json"
  ]
}
