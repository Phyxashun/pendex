{
  "name": "@pendex/api-docs",
  "version": "1.0.0",
  "description": "User guide and API documentation hub for Pendex, deployed to GitHub Pages.",
  "author": "Dustin `Dusty` Dew (Phyxashun) <phyxashun@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api-docs": "typedoc --options ../../typedoc.json",
    "build": "bun run api-docs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.4",
    "daisyui": "^5.0.35",
    "typedoc": "^0.27.9",
    "vite": "^8.1.1"
  }
}