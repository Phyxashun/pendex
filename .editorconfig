# EditorConfig is awesome: https://editorconfig.org
root = true

# All Files (Default baseline configuration)
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

# TypeScript
[*.{ts,tsx}]
# Inherits all [*] defaults

# JavaScript
[*.{js,jsx}]
# Inherits all [*] defaults

# HTML
[*.{html}]
# Inherits all [*] defaults

# Style Sheets
[*.css]
# Inherits all [*] defaults

# Mermaid
[*.{mermaid}]
# Inherits all [*] defaults

# JSON and JSONC
[*.{json,jsonc}]
indent_size = 2

# TOML
[*.{toml}]
indent_size = 2

# Markdown
[*.md]
indent_size = 2
# Markdown uses trailing double-spaces for soft line breaks
trim_trailing_whitespace = false
