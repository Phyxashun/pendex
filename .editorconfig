# EditorConfig is awesome: https://editorconfig.org
root = true

# All Files
[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

# TypeScript
[*.{ts,tsx}]

# JavaScript
[*.{js,jsx}]

# HTML
[*.{html}]

# Style Sheets
[*.css]

# Mermaid
[*.{mermaid}]

# JSON and JSONC
[*.{json,jsonc,lock}]
indent_size = 2

# TOML
[*.{toml}]

# Markdown
[*.md]
indent_size = 2

# Markdown uses trailing double-spaces for soft line breaks
trim_trailing_whitespace = false
