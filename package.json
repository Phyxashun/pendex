{
  "name": "pendex",
  "version": "2.0.2",
  "description": "Pendex turns an entire source tree into portable, plain-text archives — ideal for AI prompts, code reviews, backups, and sharing. Compile a project into banner-delimited `.txt` files grouped by job (source, web, style,  terminal, configuration, documentation, testing, misc), then reconstruct the whole tree later with `px split`.",
  "author": {
    "name": "Dustin Dew",
    "email": "phyxashun@gmail.com",
    "url": "https://phyxashun.github.io/home/"
  },
  "license": "APGL-3.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "px": "./src/index.ts"
  },
  "keywords": [
    "pendex",
    "@pendex",
    "compile",
    "split",
    "consolidate",
    "devtools",
    "merge",
    "project",
    "rebuild"
  ],
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  },
  "scripts": {
    "clear": "bun pm cache rm",
    "clean": "bun run ./clean.ts",
    "typecheck": "tsc --noEmit; bun run --filter '*' typecheck",
    "build": "bun --cwd packages/home vite build --config ../../vite.config.ts",
    "build:pendex": "bun run typecheck; bun build --compile --outfile=./dist/px ./src/index.ts",
    "build:home": "bun --filter ./packages/home build",
    "build:pendex:home": "bun --filter @pendex/home run build",
    "build:api-docs": "bun run --cwd packages/api-docs build",
    "build:pendex:api-docs": "bun --filter @pendex/api-docs run build",
    "dev": "bun vite --config ./vite.config.ts",
    "dev:filter": "bun --filter '*' run dev",
    "dev:pendex:home": "cd packages/home && bun run dev",
    "dev:pendex:api-docs": "cd packages/api-docs && bun run dev",
    "preview": "bun --filter '*' run preview",
    "start": "bun run ./src/index.ts",
    "compile": "bun run packages/compile/src/Compile.ts",
    "split": "bun run packages/split/src/Split.ts",
    "git:push": "git add . && git commit -m 'Updates' && git push origin main",
    "test": "bun test; bun --filter '*' run test",
    "test:log:win": "powershell -ExecutionPolicy Bypass -File ./log-tests.ps1",
    "test:log:linux": "./log-tests.fish",
    "nuke": "taskkill /f /im node.exe /im bun.exe /im vite.exe 2>nul || exit 0"
  },
  "dependencies": {
    "@pendex/home": "workspace:*",
    "@pendex/api-docs": "workspace:*",
    "@pendex/color": "workspace:*",
    "@pendex/theme": "workspace:*",
    "@pendex/core": "workspace:*",
    "@pendex/compile": "workspace:*",
    "@pendex/split": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "tailwindcss": "^4.3.3",
    "trash": "^10.1.1",
    "daisyui": "^5.7.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-toml": "^2.0.6",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "_comment": "Move these to dependencies when starting the PDF export and syntax highlighting features",
  "optionalDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "prismjs": "^1.30.0"
  }
}