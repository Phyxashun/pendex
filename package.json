{
  "name": "pendex",
  "version": "2.0.2",
  "description": "Pendex turns an entire source tree into portable, plain-text archives — ideal for AI prompts, code reviews, backups, and sharing. Compile a project into banner-delimited `.txt` files grouped by job (source, web, style,  terminal, configuration, documentation, testing, misc), then reconstruct the whole tree later with `px split`.",
  "author": "Dustin `Dusty` Dew (Phyxashun) <phyxashun@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "px": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit; bun run --filter '*' typecheck",
    "build": "bun run typecheck; bun build --compile --outfile=./dist/px ./src/index.ts",
    "build:home": "bun --filter ./packages/home build",
    "build:pendex:home": "bun --filter @pendex/home run build",
    "build:api-docs": "bun run --cwd packages/api-docs build",
    "build:pendex:api-docs": "bun --filter @pendex/api-docs run build",
    "dev": "bun --filter @pendex/home dev",
    "dev:api-docs": "bun run --cwd packages/api-docs dev",
    "preview:api-docs": "bun run --cwd packages/api-docs preview",
    "start": "bun run ./src/index.ts",
    "compile": "bun run packages/compile/src/Compile.ts",
    "split": "bun run packages/split/src/Split.ts",
    "git:push": "git add . && git commit -m 'Updates' && git push origin main",
    "test": "bun test; bun run --filter '*' test",
    "test:log:win": "powershell -ExecutionPolicy Bypass -File ./log-tests.ps1",
    "test:log": "./log-tests.fish"
  },
  "dependencies": {
    "@pendex/home": "workspace:*",
    "@pendex/api-docs": "workspace:*",
    "@pendex/color": "workspace:*",
    "@pendex/theme": "workspace:*",
    "@pendex/core": "workspace:*",
    "@pendex/compile": "workspace:*",
    "@pendex/split": "workspace:*",
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "daisyui": "^5.7.4",
    "home": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}